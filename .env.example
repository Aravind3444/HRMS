# ─── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
APP_PORT=3000
APP_URL=http://localhost:3000
WEB_URL=http://localhost:5173

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://hrms:hrms_dev_secret@localhost:5432/hrms_dev?schema=public

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://:hrms_redis_secret@localhost:6379

# ─── Sessions & Auth ──────────────────────────────────────────────────────────
SESSION_SECRET=change-me-min-32-chars-long-secret-key-here
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
CSRF_SECRET=change-me-csrf-secret-key

# ─── AWS / S3 (MinIO for local dev) ───────────────────────────────────────────
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=hrms_minio_user
AWS_SECRET_ACCESS_KEY=hrms_minio_secret
AWS_S3_BUCKET=hrms-files
S3_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true

# ─── Email (MailHog for local dev) ────────────────────────────────────────────
EMAIL_PROVIDER=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
EMAIL_FROM=noreply@hrms.local

# ─── Platform ─────────────────────────────────────────────────────────────────
PLATFORM_AUTO_APPROVE_TENANTS=true
TRIAL_DURATION_DAYS=14
MAX_MEMBERSHIPS_PER_USER=1

# ─── Feature Flags (GATE-xx) ──────────────────────────────────────────────────
FEATURE_ATTENDANCE_COMPUTATION=false
FEATURE_NATIVE_PAYROLL=false
FEATURE_FINANCE_CORE=false

# ─── Field-level Encryption ───────────────────────────────────────────────────
FIELD_ENCRYPTION_KEY=change-me-must-be-64-hex-chars-aes256

# ─── Observability ────────────────────────────────────────────────────────────
LOG_LEVEL=debug
SENTRY_DSN=

