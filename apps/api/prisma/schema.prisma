datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// 1. TENANT & SUBSCRIPTION CONFIGURATION
// ==========================================

model Tenant {
  id                   String   @id @default(uuid()) @db.Uuid
  name                 String   @db.VarChar(255)
  slug                 String   @unique @db.VarChar(100)
  status               String   @default("pending_review") @db.VarChar(50) // pending_review, active, suspended, cancelled, archived
  planTier             String   @default("starter") @map("plan_tier") @db.VarChar(50)
  trialEndsAt          DateTime? @map("trial_ends_at") @db.Timestamptz()
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  settings              TenantSettings?
  subscription          Subscription?
  legalEntities         LegalEntity[]
  locations             Location[]
  departments           Department[]
  designations          Designation[]
  grades                Grade[]
  costCenters           CostCenter[]
  employmentTypes       EmploymentType[]
  memberships           Membership[]
  roles                 Role[]
  invitations           Invitation[]
  auditEvents           AuditEvent[]
  outboxEvents          OutboxEvent[]
  attendancePolicies    AttendancePolicyVersion[]
  leaveTypes            LeaveType[]
  holidayCalendars      HolidayCalendar[]
  workflowDefinitions   WorkflowDefinition[]
  approvalInstances     ApprovalInstance[]
  approvalTasks         ApprovalTask[]
  delegations           Delegation[]
  notificationTemplates NotificationTemplate[]
  notificationDeliveries NotificationDelivery[]
  featureFlags          FeatureFlag[]
  employees             Employee[]
  employeeDocuments     EmployeeDocument[]
  employeeEmergencyContacts EmployeeEmergencyContact[]
  employeeBankDetails   EmployeeBankDetail[]
  employeeTaxInfos      EmployeeTaxInfo[]

  // M05 Employee Self-Service
  employeeProfiles      EmployeeProfile[]
  employeeFamilies      EmployeeFamily[]
  employeeEducations    EmployeeEducation[]
  employeeExperiences   EmployeeExperience[]

  // M06 Documents Management
  documentTypes         DocumentType[]
  companyDocuments      CompanyDocument[]
  documentTemplates     DocumentTemplate[]
  policyDocuments       PolicyDocument[]

  // M07 Recruitment
  requisitions          Requisition[]
  jobs                  Job[]
  candidates            Candidate[]
  interviews            Interview[]
  offers                Offer[]
  referrals             Referral[]

  // M08 Onboarding
  onboardingTemplates   OnboardingTemplate[]
  onboardingTasks       OnboardingTask[]
  onboardingCases       OnboardingCase[]
  onboardingCaseTasks   OnboardingCaseTask[]

  // M09 Offboarding
  resignations          Resignation[]
  terminations          Termination[]
  clearanceChecklists   ClearanceChecklist[]
  exitInterviews        ExitInterview[]

  // M10 Attendance
  attendanceDays        AttendanceDay[]
  punches               Punch[]
  overtime              Overtime[]
  regularizations       Regularization[]

  // M11 Shift & Roster
  shiftTemplates        ShiftTemplate[]
  rosters               Roster[]
  shiftSwaps            ShiftSwap[]

  // M12 Leave
  leavePolicies         LeavePolicy[]
  leaveApplications     LeaveApplication[]
  leaveLedgerEntries    LeaveLedger[]
  compOffs              CompOff[]

  // M13 Payroll
  payrollComponents     PayrollComponent[]
  salaryStructures      SalaryStructure[]
  employeeCompensations EmployeeCompensation[]
  payrollPeriods        PayrollPeriod[]
  payrollRuns           PayrollRun[]
  payslips              Payslip[]
  loans                 Loan[]
  fnfEntries            FnF[]

  // M14 Statutory Compliance
  statutoryRuleSets     StatutoryRuleSet[]
  pfContributions       PFContribution[]
  esiContributions      ESIContribution[]
  ptContributions       PTContribution[]
  lwfContributions      LWFContribution[]
  investmentDeclarations InvestmentDeclaration[]
  proofSubmissions      ProofSubmission[]
  tdsComputations       TDSComputation[]
  form16s               Form16[]
  form24qs              Form24Q[]
  complianceCalendars   ComplianceCalendar[]

  // M15 Performance
  reviewCycles          ReviewCycle[]
  reviews               Review[]
  goals                 Goal[]
  checkIns              CheckIn[]
  feedbacks             Feedback[]
  calibrations          Calibration[]
  pips                  PIP[]

  // M16 LMS
  courses               Course[]
  enrollments           Enrollment[]
  assessments           Assessment[]
  certifications        Certification[]
  trainingRequests      TrainingRequest[]

  // M17 Assets
  assetCategories       AssetCategory[]
  assetItems            AssetItem[]
  assetRequests         AssetRequest[]
  assetReturns          AssetReturn[]

  // M18 Helpdesk
  ticketCategories      TicketCategory[]
  helpdeskTickets       HelpdeskTicket[]
  ticketComments        TicketComment[]
  knowledgeBaseArticles KnowledgeBase[]

  // M19 Expense
  expensePolicies       ExpensePolicy[]
  expenseClaims         ExpenseClaim[]
  expenseClaimLines     ExpenseClaimLine[]
  expenseAdvances       ExpenseAdvance[]

  // M20 Travel
  travelPolicies        TravelPolicy[]
  travelRequests        TravelRequest[]
  travelBookings        TravelBooking[]

  // M21 Engagement
  announcements         Announcement[]
  announcementReads     AnnouncementRead[]
  surveys               Survey[]
  surveyQuestions       SurveyQuestion[]
  surveyResponses       SurveyResponse[]
  recognitions          Recognition[]

  // M22 Reports
  reportTemplates       ReportTemplate[]
  reportExecutions      ReportExecution[]

  // M23 Audit
  dataPrincipalRequests DataPrincipalRequest[]
  loginHistories        LoginHistory[]

  // M26 Integrations
  webhookSubscriptions  WebhookSubscription[]
  webhookDeliveries     WebhookDelivery[]
  apiKeys               ApiKey[]

  // M28 Security
  securityEvents        SecurityEvent[]
  encryptionKeys        EncryptionKey[]

  // M29 Import/Export
  importJobs            ImportJob[]
  exportJobs            ExportJob[]

  // M30 Finance
  chartOfAccounts       ChartOfAccount[]
  fiscalPeriods         FiscalPeriod[]
  journalEntries        JournalEntry[]
  journalLines          JournalLine[]

  // M31 AI
  aiConversations       AIConversation[]
  aiMessages            AIMessage[]

  @@map("tenants")
}

model Plan {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(50) // starter, standard, enterprise
  name        String   @db.VarChar(100)
  description String?  @db.VarChar(255)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  versions PlanVersion[]

  @@map("plans")
}

model PlanVersion {
  id              String   @id @default(uuid()) @db.Uuid
  planId          String   @map("plan_id") @db.Uuid
  version         Int      @default(1)
  basePrice       Decimal  @default(0) @map("base_price") @db.Decimal(12, 2)
  perSeatPrice    Decimal  @default(0) @map("per_seat_price") @db.Decimal(12, 2)
  currency        String   @default("INR") @db.VarChar(3)
  seatLimitDefault Int     @default(50) @map("seat_limit_default")
  modulesIncluded Json     @map("modules_included") @db.JsonB // e.g. ["M01", "M02", "M03", "M04", "M05", "M06", "M10", "M12"]
  isPublished     Boolean  @default(true) @map("is_published")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  plan          Plan           @relation(fields: [planId], references: [id], onDelete: Cascade)
  subscriptions Subscription[]

  @@unique([planId, version])
  @@map("plan_versions")
}

model Subscription {
  id               String    @id @default(uuid()) @db.Uuid
  tenantId         String    @unique @map("tenant_id") @db.Uuid
  planVersionId    String    @map("plan_version_id") @db.Uuid
  status           String    @default("pending") @db.VarChar(50) // pending, trial, active, past_due, suspended, cancelled, expired
  seatLimit        Int       @default(50) @map("seat_limit")
  trialStartsAt    DateTime? @map("trial_starts_at") @db.Timestamptz()
  trialEndsAt      DateTime? @map("trial_ends_at") @db.Timestamptz()
  currentPeriodStart DateTime? @map("current_period_start") @db.Timestamptz()
  currentPeriodEnd   DateTime? @map("current_period_end") @db.Timestamptz()
  cancelledAt      DateTime? @map("cancelled_at") @db.Timestamptz()
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  planVersion PlanVersion @relation(fields: [planVersionId], references: [id], onDelete: Restrict)

  @@index([status])
  @@map("subscriptions")
}

model TenantSettings {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @unique @map("tenant_id") @db.Uuid
  country         String   @default("IN") @db.VarChar(2)
  timezone        String   @default("Asia/Kolkata") @db.VarChar(100)
  currency        String   @default("INR") @db.VarChar(3)
  weekStartDay    Int      @default(1) @map("week_start_day") // 1 = Monday
  mfaRequired     Boolean  @default(false) @map("mfa_required")
  sessionTtlHours Int      @default(12) @map("session_ttl_hours")
  setupCompleted  Boolean  @default(false) @map("setup_completed")
  completedAt     DateTime? @map("completed_at") @db.Timestamptz()
  completedBy     String?  @map("completed_by") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_settings")
}

// ==========================================
// 2. ORGANIZATION STRUCTURE (INDIA-FIRST)
// ==========================================

model LegalEntity {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  name       String   @db.VarChar(255)
  code       String   @db.VarChar(50)
  isDefault  Boolean  @default(false) @map("is_default")
  
  // Indian Statutory Registrations
  cin        String?  @db.VarChar(21) // Corporate Identification Number
  pan        String?  @db.VarChar(10) // Permanent Account Number
  tan        String?  @db.VarChar(10) // Tax Deduction Account Number
  gstin      String?  @db.VarChar(15) // Goods and Services Tax ID
  pfNumber   String?  @map("pf_number") @db.VarChar(50) // Provident Fund
  esiNumber  String?  @map("esi_number") @db.VarChar(50) // Employee State Insurance
  
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  locations Location[]
  holidayCalendars HolidayCalendar[]
  employees Employee[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("legal_entities")
}

model Location {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  legalEntityId  String   @map("legal_entity_id") @db.Uuid
  name           String   @db.VarChar(255)
  code           String   @db.VarChar(50)
  address        String   @db.Text
  state          String   @db.VarChar(100)
  pincode        String   @db.VarChar(10)
  timezone       String   @default("Asia/Kolkata") @db.VarChar(100)
  latitude       Float?   // For geofence
  longitude      Float?   // For geofence
  geofenceRadius Int?     @map("geofence_radius") // In meters, 50-2000
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  legalEntity LegalEntity  @relation(fields: [legalEntityId], references: [id], onDelete: Cascade)
  employees   Employee[]

  @@unique([tenantId, code])
  @@index([tenantId, legalEntityId])
  @@map("locations")
}

model Department {
  id                  String   @id @default(uuid()) @db.Uuid
  tenantId            String   @map("tenant_id") @db.Uuid
  parentDepartmentId  String?  @map("parent_department_id") @db.Uuid
  name                String   @db.VarChar(255)
  code                String   @db.VarChar(50)
  description         String?  @db.Text
  headEmployeeId      String?  @map("head_employee_id") @db.Uuid
  isActive            Boolean  @default(true) @map("is_active")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  tenant           Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parentDepartment Department? @relation("DepartmentHierarchy", fields: [parentDepartmentId], references: [id], onDelete: SetNull)
  childDepartments Department[] @relation("DepartmentHierarchy")
  employees          Employee[]

  @@unique([tenantId, code])
  @@index([tenantId, parentDepartmentId])
  @@map("departments")
}

model Designation {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  code        String   @db.VarChar(50)
  name        String   @db.VarChar(255)
  description String?  @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employees Employee[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("designations")
}

model Grade {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  code        String   @db.VarChar(50)
  name        String   @db.VarChar(255)
  description String?  @db.Text
  minSalary   Float?   @map("min_salary")
  maxSalary   Float?   @map("max_salary")
  currency    String   @default("INR") @db.VarChar(10)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employees Employee[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("grades")
}

model CostCenter {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  code        String   @db.VarChar(50)
  name        String   @db.VarChar(255)
  description String?  @db.Text
  parentId    String?  @map("parent_id") @db.Uuid
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  tenant             Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parentCostCenter   CostCenter? @relation("CostCenterHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  childCostCenters   CostCenter[] @relation("CostCenterHierarchy")
  employees          Employee[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("cost_centers")
}

model EmploymentType {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  code        String   @db.VarChar(50)
  name        String   @db.VarChar(255)
  description String?  @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employees Employee[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("employment_types")
}

// ==========================================
// 3. EMPLOYEE MANAGEMENT (MODULE 4)
// ==========================================

model Employee {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  legalEntityId String  @map("legal_entity_id") @db.Uuid
  locationId   String?  @map("location_id") @db.Uuid
  departmentId String?  @map("department_id") @db.Uuid
  designationId String? @map("designation_id") @db.Uuid
  gradeId      String?  @map("grade_id") @db.Uuid
  costCenterId  String?  @map("cost_center_id") @db.Uuid
  employmentTypeId String? @map("employment_type_id") @db.Uuid
  employeeCode   String   @map("employee_code") @db.VarChar(50)
  employeeType   String   @map("employee_type") @db.VarChar(50) // full_time, part_time, contract, intern
  dateOfJoining  DateTime @map("date_of_joining") @db.Timestamptz()
  dateOfBirth    DateTime? @map("date_of_birth") @db.Timestamptz()
  gender         String?  @map("gender") @db.VarChar(20)
  bloodGroup     String?  @map("blood_group") @db.VarChar(10)
  maritalStatus  String?  @map("marital_status") @db.VarChar(20)
  address        String?  @map("address") @db.Text
  city           String?  @map("city") @db.VarChar(100)
  state          String?  @map("state") @db.VarChar(100)
  pincode        String?  @map("pincode") @db.VarChar(20)
  country        String?  @map("country") @db.VarChar(100)
  emergencyContactName  String?  @map("emergency_contact_name") @db.VarChar(255)
  emergencyContactPhone String?  @map("emergency_contact_phone") @db.VarChar(20)
  emergencyContactRelation String? @map("emergency_contact_relation") @db.VarChar(50)
  panNumber     String?  @map("pan_number") @db.VarChar(20)
  aadhaarNumber String?  @map("aadhaar_number") @db.VarChar(30)
  bankAccountNumber String? @map("bank_account_number") @db.VarChar(50)
  bankName      String?  @map("bank_name") @db.VarChar(255)
  bankBranch    String?  @map("bank_branch") @db.VarChar(255)
  bankIFSC      String?  @map("bank_ifsc") @db.VarChar(20)
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  tenant           Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  legalEntity      LegalEntity   @relation(fields: [legalEntityId], references: [id], onDelete: Cascade)
  location         Location?     @relation(fields: [locationId], references: [id], onDelete: SetNull)
  department       Department?   @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  designation      Designation?  @relation(fields: [designationId], references: [id], onDelete: SetNull)
  grade            Grade?        @relation(fields: [gradeId], references: [id], onDelete: SetNull)
  costCenter       CostCenter?   @relation(fields: [costCenterId], references: [id], onDelete: SetNull)
  employmentType   EmploymentType? @relation(fields: [employmentTypeId], references: [id], onDelete: SetNull)
  employeeDocuments EmployeeDocument[]
  employeeEmergencyContacts EmployeeEmergencyContact[]
  employeeBankDetails EmployeeBankDetail[]
  employeeTaxInfos EmployeeTaxInfo[]

  @@unique([tenantId, employeeCode])
  @@unique([tenantId, userId])
  @@index([tenantId])
  @@index([tenantId, departmentId])
  @@index([tenantId, designationId])
  @@index([tenantId, employmentTypeId])
  @@map("employees")
}

model EmployeeDocument {
  id           String   @id @default(uuid()) @db.Uuid
  employeeId   String   @map("employee_id") @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  documentType String   @map("document_type") @db.VarChar(100) // ID_PROOF, ADDRESS_PROOF, PAN, PASSPORT, etc.
  documentName String   @map("document_name") @db.VarChar(255)
  fileUrl      String   @map("file_url") @db.Text
  fileSize     Int?     @map("file_size")
  uploadedAt   DateTime @default(now()) @map("uploaded_at") @db.Timestamptz()
  expiryDate   DateTime? @map("expiry_date") @db.Timestamptz()
  isActive     Boolean  @default(true) @map("is_active")

  employee  Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([employeeId])
  @@map("employee_documents")
}

model EmployeeEmergencyContact {
  id          String   @id @default(uuid()) @db.Uuid
  employeeId  String   @map("employee_id") @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  name        String   @map("name") @db.VarChar(255)
  relationship String   @map("relationship") @db.VarChar(100)
  phone       String   @map("phone") @db.VarChar(20)
  email       String?  @map("email") @db.VarChar(255)
  isPrimary   Boolean  @default(false) @map("is_primary")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([employeeId])
  @@map("employee_emergency_contacts")
}

model EmployeeBankDetail {
  id            String   @id @default(uuid()) @db.Uuid
  employeeId    String   @map("employee_id") @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  bankName      String   @map("bank_name") @db.VarChar(255)
  branchName    String   @map("branch_name") @db.VarChar(255)
  accountNumber String   @map("account_number") @db.VarChar(50)
  ifscCode      String   @map("ifsc_code") @db.VarChar(20)
  accountType   String   @map("account_type") @db.VarChar(50) // SAVINGS, CURRENT
  isPrimary     Boolean  @default(true) @map("is_primary")
  isVerified    Boolean  @default(false) @map("is_verified")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz()

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([employeeId])
  @@map("employee_bank_details")
}

model EmployeeTaxInfo {
  id           String   @id @default(uuid()) @db.Uuid
  employeeId   String   @map("employee_id") @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  panNumber    String?  @map("pan_number") @db.VarChar(20)
  aadhaarNumber String? @map("aadhaar_number") @db.VarChar(30)
  uanNumber    String?  @map("uan_number") @db.VarChar(30) // Universal Account Number for PF
  bankAccountNumber String? @map("bank_account_number") @db.VarChar(50)
  bankName     String?  @map("bank_name") @db.VarChar(255)
  bankIFSC     String?  @map("bank_ifsc") @db.VarChar(20)
  taxSlab      String?  @map("tax_slab") @db.VarChar(50)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, employeeId])
  @@index([tenantId])
  @@index([employeeId])
  @@map("employee_tax_info")
}

// ==========================================
// 3. IDENTITY & AUTHENTICATION
// ==========================================

model User {
  id              String   @id @default(uuid()) @db.Uuid
  email           String   @unique @db.VarChar(255)
  passwordHash    String   @map("password_hash") @db.VarChar(255)
  fullName        String   @map("full_name") @db.VarChar(255)
  phoneNumber     String?  @map("phone_number") @db.VarChar(20)
  isPlatformAdmin Boolean  @default(false) @map("is_platform_admin")
  isEmailVerified Boolean  @default(false) @map("is_email_verified")
  mfaEnabled      Boolean  @default(false) @map("mfa_enabled")
